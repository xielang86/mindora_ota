[Unit]
Description=OTA server (Gunicorn)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/server/ota_server
EnvironmentFile=-/etc/default/ota-server
StateDirectory=ota-server
StateDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
Environment=OTA_LOG_DIR=/var/log/ota-server
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/server/ota_server/.venv/bin/gunicorn --bind 0.0.0.0:4242 --workers 2 --threads 4 --timeout 120 --config /root/server/ota_server/gunicorn.conf.py server:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/log/ota-server
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
